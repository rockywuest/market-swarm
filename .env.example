# Market Swarm configuration
#
# For real simulations, set at least one LLM API key
# (provider priority: Gemini > Anthropic > OpenRouter > OpenAI):
#
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# No key? Run the offline demo instead — deterministic sample output,
# no LLM calls, no cost:
# MARKET_SWARM_MOCK=1

# Default model (overridable per run via --model / API model_name)
# MARKET_SWARM_MODEL=claude-opus-4-8
